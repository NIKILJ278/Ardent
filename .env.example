# --- Core ---
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# ── Database ────────────────────────────────────────────────────────────────
# Local development: SQLite (no extra setup needed)
DATABASE_URL=sqlite:///brandstack.db
#
# Production — use a hosted PostgreSQL service.
# The backend rewrites "postgres://" → "postgresql://" automatically, so
# paste the URL as-is from your provider.
#
# Neon  (https://neon.tech  — free tier, serverless)
#   DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# Supabase  (https://supabase.com  — free tier)
#   DATABASE_URL=postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres
#
# Railway  (https://railway.app)
#   DATABASE_URL=postgresql://postgres:pass@containers-us-west-xxx.railway.app:5432/railway
#
# Aiven / ElephantSQL / any other provider: copy the connection URI directly.
# ────────────────────────────────────────────────────────────────────────────

# Write a login_sessions row on every successful sign-in (set to false to disable).
AUDIT_LOGINS=true


# Encrypts every platform API key/token entered on the Data Sources page.
# Set this to a long random value — required for real use.
CREDENTIALS_KEY=

# --- AI assistant ---
ANTHROPIC_API_KEY=

# --- Shopify ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_products,read_inventory,read_customers
SHOPIFY_REDIRECT_URI=http://localhost:5000/api/connectors/shopify/callback

# --- Meta (Facebook/Instagram Ads) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/connectors/meta/callback

# --- Google (Ads + GA4) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/connectors/google/callback

# --- Marketplaces / logistics (Amazon, Flipkart, Myntra, Unicommerce, iThink, Judge.me) ---
UNICOMMERCE_API_KEY=
JUDGEME_API_KEY=
